# MadziHub environment. Copy to .env (never commit .env) or set in the service manager.
# Legacy SRWB_* names are still accepted for existing installations.

# Which utility this installation serves: a folder under tenants/ or a path to a YAML file.
MADZI_TENANT=demo

# development | production. Production refuses to start without a strong secret and CORS origins.
MADZI_ENV=production
MADZI_SECRET_KEY=change-me-to-a-long-random-string
MADZI_ALLOWED_ORIGINS=https://performance.example.org

# Optional: defaults to sqlite:///data/madzihub.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/madzihub

# Passwordless local preview login for UI QA. Leave off on any shared machine.
MADZI_DEV_PREVIEW=false

MADZI_LOG_LEVEL=INFO
UPLOAD_LIMIT_MB=50
